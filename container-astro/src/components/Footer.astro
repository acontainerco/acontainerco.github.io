<div id="footer">
  <div id="footer-content">
    <div style="margin: 0 auto;">
      <img style="height: 10vh;" src="/img/logo.png">
    </div>
    <ul id="social">
      <li><a href="https://www.facebook.com/acontainerco" target="_blank"><img src="/img/icons/container-facebook.png">Facebook</a></li>
      <li><a href="https://www.instagram.com/acontainerco" target="_blank"><img src="/img/icons/container-instagram.png">Instagram</a></li>
      <li><a href="https://www.twitter.com/acontainerco" target="_blank"><img src="/img/icons/container-twitter.png">Twitter</a></li>
    </ul>
  </div>
</div>
<script src="https://unpkg.com/@glidejs/glide@3.6.0/dist/glide.js" is:inline></script>
<script src="/js/lightbox/lightbox.min.js" is:inline></script>
<script is:inline>
  let glider;
  Array.from(document.getElementsByClassName('glide')).forEach(elem => {
    glider = new Glide(elem, {
      type: 'carousel',
      startAt: 0,
      perView: 4,
      gap: "10%",
      breakpoints: {
        800: { perView: 2 },
        600: { perView: 1 },
        300: { perView: 1 }
      }
    });
    glider.mount();
  });
  FlexMasonry.refreshAll();
</script>
</body>
</html>
