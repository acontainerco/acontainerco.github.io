---
import { joinArtistNames } from '../utils/artists';
import { renderMarkdown } from '../utils/markdown';
import GalleryImage from './GalleryImage.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, artists, summary, production_details, slug, images } = project.data;
---

<div class="project-2-up">
  <div class="masonry">
    {images.map((image) => (
      <div>
        <GalleryImage slug={slug} src={image.name} alt={image.alt || 'Product photo'} />
      </div>
    ))}
  </div>
  <div id="details" class="project featured">
    <h2>{title}</h2>
    <h3>{joinArtistNames(artists)}</h3>
    <p>{summary}</p>
    {production_details && <p set:html={renderMarkdown(production_details)} />}
    <p class="button learn"><a href={`/projects/${slug}`}>Learn more ⟶</a></p>
  </div>
</div>
