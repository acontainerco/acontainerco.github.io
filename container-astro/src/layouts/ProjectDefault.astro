---
import { isMultipleArtists, joinArtistNames } from '../utils/artists';
import { renderMarkdown } from '../utils/markdown';
import GalleryImage from '../components/GalleryImage.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import ShippingInfo from '../components/ShippingInfo.astro';
import ShopButtons from '../components/ShopButtons.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, artists, price, sold_out, shipping_us, shipping_intl, shipping_included, images, shop } = project.data;
const slug = project.id.replace(/\.md$/, '');
const multiple = isMultipleArtists(artists);
---

<style>
  section li {
  }
  section li:first-of-type {
    margin-top: 0;
  }
</style>

<section>
  <div class="content" style="display: unset;">
    <div class="masonry">
      {images.map((image) => (
        <div>
          <GalleryImage slug={slug} src={image.name} alt={image.alt || 'Product photo'} />
        </div>
      ))}
    </div>
    <div id="details" class="featured">
      <h2>{title}</h2>
      <h3>{joinArtistNames(artists)}</h3>
      {sold_out ? (
        <p>Sold out</p>
      ) : (
        <>
          {price != null && <p>${price}</p>}
          <ShippingInfo us={shipping_us} intl={shipping_intl} included={shipping_included} />
        </>
      )}
      {!sold_out && shop.length > 0 && <ShopButtons entries={shop} />}
    </div>
  </div>
</section>

<section>
  <div class="content" style="display: block;">
    <slot />
    <h2>About the artist{multiple ? 's' : ''}</h2>
    <div class={multiple ? 'content' : ''}>
      {artists.map((artist) => (
        multiple ? (
          <div class="project-2-up">
            {artist.photo && (
              <ResponsiveImage dir="people" src={artist.photo} alt={artist.name} />
            )}
            <div set:html={renderMarkdown(artist.bio)} />
          </div>
        ) : (
          <div class="project-2-up">
            <div class="single-contributor" style={!artist.photo ? 'display: block;' : ''}>
              {artist.photo && (
                <ResponsiveImage dir="people" src={artist.photo} alt={artist.name} />
              )}
              <div set:html={renderMarkdown(artist.bio)} />
            </div>
            <div style="clear: both" />
          </div>
        )
      ))}
    </div>
  </div>
</section>
