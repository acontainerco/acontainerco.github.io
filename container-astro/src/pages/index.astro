---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectLeftAligned from '../components/ProjectLeftAligned.astro';
import ProjectRightAligned from '../components/ProjectRightAligned.astro';
import Project2Up from '../components/Project2Up.astro';
import jenniImage from '../assets/img/people/jenni.jpg';
import dougImage from '../assets/img/people/doug.jpg';
import lookBookHeader from '../assets/img/projects/look-book-2019/lb_header_2019.png';

const projects = await getCollection('projects');

const latestObject = projects.find((p) =>
  p.data.tags.includes('latest') &&
  p.data.tags.includes('objects') &&
  !p.data.tags.includes('Look Book')
);

const latestLookBook = projects.find((p) =>
  p.data.tags.includes('latest') &&
  p.data.tags.includes('Look Book')
);

const otherObjects = projects.filter((p) =>
  p.data.tags.includes('objects') &&
  !p.data.tags.includes('latest') &&
  !p.data.tags.includes('Look Book')
);

const latestMultitudes = projects.find((p) =>
  p.data.tags.includes('latest') &&
  p.data.tags.includes('Multitudes')
);
---

<Base title="language in novel forms">
  <section>
    <div class="content">
      <p class="series-description press-description first-para">
        Abstract form whose instances are collections of other objects.
        Often projects take the shape of things that are not normally
        classified as "book-like." Rarely, our objects look like traditional books.
        It depends.
      </p>
      <h2>Latest object</h2>
      {latestObject && <ProjectLeftAligned project={latestObject} />}
    </div>
  </section>

  <section>
    <div class="content">
      <h2 id="look-books-section"><a href="/series/Look%20Book" class="series-link">Look-Books</a></h2>
      <Image class="section-feature" src={lookBookHeader} alt="Red ViewFinder with six circular reels spreading horizontally." />
      <p class="series-description">
        Laced with the "are we there yet?" vacation nostalgia of the 1980s and '90s, the Look Book series invites artists
        to submit work that functions best in the classic view reel format. Each year, we solicit up to six (6) participants
        to contribute to a year-long subscription series that delivers a new reel to your mailbox every two (2) months.
      </p>
      {latestLookBook && <ProjectRightAligned project={latestLookBook} />}
    </div>
    <div class="see-more learn"><p class="button"><a href="/series/Look%20Book">See other editions ⟶</a></p></div>
  </section>

  <section>
    <div class="content">
      <h2 id="project-section"><a href="/series/objects" class="series-link">Objects</a></h2>
      <p class="series-description">
        Closed-edition large projects. We accept submissions and, on occasion, solicit artists to
        produce these works through a highly collaborative process, including editorial and conceptual work around submitted text
        and form(s). We traditionally produce editions of 25 to 30 copies.
      </p>
      {otherObjects.map((project) => (
        <Project2Up project={project} />
      ))}
    </div>
    <div class="see-more learn"><p class="button"><a href="/series/objects">See other projects ⟶</a></p></div>
  </section>

  <section>
    <div class="content">
      <h2 id="multitudes-section"><a href="/series/multitudes" class="series-link">Multitudes</a></h2>
      <p class="series-description">
        Faced with a challenge to make a bookwork from such materials as a rolodex or vintage lunch box, artists engaged in the
        Multitudes series take-on well-known objects and forms with unique and (un)characteristic approaches. These works transform mundane objects into text-based
        experiences and engagements that defy, reconfigure, or emerge into what they appear to be.
      </p>
      {latestMultitudes && <ProjectLeftAligned project={latestMultitudes} />}
    </div>
    <div class="see-more learn"><p class="button"><a href="/series/Multitudes">See other projects ⟶</a></p></div>
  </section>

  <section>
    <div class="content columnar" style="margin-bottom: 2em;">
      <h2 id="about-section">About</h2>
      <p>Container's original run was from 2017 - 2019 under direction of
        Douglas Luman and Jenni B. Baker. This period of the press took a
        long rest after Jenni's death in late 2020 due to complications
        from glioblastoma, a rare form of brain cancer.</p>
      <p>In 2023, Container woke up.</p>
    </div>
    <div class="content" style="grid-column: 1 / span 2">
      <h3>Collection details</h3>
      <p style="grid-column: 1 / span 2">Container's text objects and artist's books can be found in the collections of many institutions.
        We thank them for their care and curation of our work. These include:
      </p>
      <ul id="institutions-list">
        <li>The Arab American National Museum</li>
        <li>The Art Gallery of Ontario</li>
        <li>Brown University</li>
        <li>Cleveland Institute of Art</li>
        <li>Duke University</li>
        <li>Maine College of Art (MECA)</li>
        <li>Ohio University</li>
        <li>The Poetry Center at the University of Arizona</li>
        <li>The Poetry Foundation Library</li>
        <li>Rhode Island School of Design (RISD)</li>
        <li>Ringling College of Art and Design</li>
        <li>School of the Art Institute of Chicago (SAIC)</li>
        <li>St. Lawrence University</li>
        <li>SUNY Buffalo</li>
        <li>UCLA</li>
        <li>Swarthmore College</li>
        <li>University of Maryland Baltimore County</li>
        <li>University of Minnesota Minneapolis</li>
      </ul>
    </div>
    <aside id="masthead" style="display: block;">
      <div class="content">
        <h3>Masthead</h3>
        <div class="project-2-up">
          <h4 style="margin-bottom: 5vh;">Jenni B. Baker</h4>
          <Image src={jenniImage} alt="Jenni B. Baker" style="display: inline;" />
          <p>(1984 - 2020). Poet and artist. She created poetry and text objects from David Foster Wallace's <em>Infinite Jest</em>,
            the <em>Boy Scouts of America Handbook</em>, <em>Grimm's Household Tales</em>, <em>Washington Post</em> articles,
            <em>This American Life</em> transcripts, standardized tests, sign language dictionaries, NASA mission voice transcriptions,
            dream interpretation books, Pac-Man guidebooks, science experiment manuals, video game walkthroughs, chess manuals,
            <em>Paris Review</em> interviews, internet searches and more.
            Find out more about her and her work <a href="http://jennibbaker.com" target="_blank">at her site</a>.
          </p>
        </div>
        <div class="project-2-up">
          <h4 style="margin-bottom: 5vh;">Douglas Luman</h4>
          <Image src={dougImage} alt="Douglas Luman" style="display: inline; width: 150px;" />
          <p>Multi-disciplinary artist and digital human based in Pittsburgh, Pennsylvania. They received their MFA
            from George Mason University. They are the head researcher at <a href="https://appliedpoetics.org" target="_blank">appliedpoetics.org</a>, and
            the author of three books: <a href="https://asterismbooks.com/product/the-f-text-douglas-luman/" target="_blank"><em>The F Text</em></a> (Inside the Castle, 2017),
            <a href="https://sublunaryeditions.com/products/rationalism-douglas-luman" target="_blank"><em>Rationalism</em></a> (Sublunary Editions, 2021),
            and <a href="https://asterismbooks.com/product/worldpicture" target="_blank">worldpicture</a> (Inside the Castle, 2026).</p>
        </div>
      </div>
    </aside>
  </section>

  <section>
    <div class="content">
      <h2 id="submit-section">Submit</h2>
      <p>Container is currently closed for submissions. When we reopen, we will make this announcement
        via our Facebook, Twitter, and Instagram accounts. See below for links to these.</p>
    </div>
  </section>
</Base>
