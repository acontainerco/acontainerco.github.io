---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectDefault from '../../layouts/ProjectDefault.astro';
import ProjectMultiple from '../../layouts/ProjectMultiple.astro';
import ProjectMultipleEdition from '../../layouts/ProjectMultipleEdition.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id.replace(/\.md$/, '') },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const type = project.data.type;
---

<Base title={project.data.title}>
  {type === 'edition' ? (
    <ProjectMultipleEdition project={project}>
      <Content />
    </ProjectMultipleEdition>
  ) : type === 'multiple' ? (
    <ProjectMultiple project={project}>
      <Content />
    </ProjectMultiple>
  ) : (
    <ProjectDefault project={project}>
      <Content />
    </ProjectDefault>
  )}
</Base>
