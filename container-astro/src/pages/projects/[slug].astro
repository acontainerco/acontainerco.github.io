---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectDefault from '../../layouts/ProjectDefault.astro';
import ProjectMultiple from '../../layouts/ProjectMultiple.astro';
import ProjectMultipleEdition from '../../layouts/ProjectMultipleEdition.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const layout = project.data.layout || 'layouts/project.njk';
---

<Base title={project.data.title}>
  {layout.includes('project_multiple_edition') ? (
    <ProjectMultipleEdition project={project}>
      <Content />
    </ProjectMultipleEdition>
  ) : layout.includes('project_multiple') ? (
    <ProjectMultiple project={project}>
      <Content />
    </ProjectMultiple>
  ) : (
    <ProjectDefault project={project}>
      <Content />
    </ProjectDefault>
  )}
</Base>
